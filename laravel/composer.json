{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "jadeer-united/web-platform",
  "type": "project",
  "description": "Jadeer United Leasing & Motors — Corporate Operational Leasing, Showroom, Used Cars, and Admin Portal (Laravel 12).",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "laravel/tinker": "^2.10"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "laravel/breeze": "^2.3",
    "laravel/pint": "^1.20",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
